# Environment configuration for Quantum-Secure Cryptography Platform
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=*

# Authentication Secrets (Replace in production deployment!)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=replace_with_strong_password_in_production

# Storage and Transfer Limits
MAX_UPLOAD_SIZE_MB=15
STORAGE_DIR=storage
